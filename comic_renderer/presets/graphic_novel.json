{
    "name": "graphic_novel",
    "description": "High-contrast, gritty black-and-white comic style with dramatic ink edges. Mimics the look of a classic Western graphic novel.",
    "version": "2.0",
    "pipeline": [
        {"filter": "grayscale",   "params": {"method": "luminance"}},
        {"filter": "clahe",       "params": {"clip_limit": 4.5, "tile_grid_size": [16, 16]}},
        {"filter": "tonecurve",   "params": {"points": [[0, 0], [20, 80], [45, 105], [90, 120], [150, 160], [255, 255]]}},
        {"filter": "bilateral",   "params": {"diameter": 9, "sigma_color": 80.0, "sigma_space": 80.0, "iterations": 2}},
        {"filter": "posterize",   "params": {"levels": 4}},
        {"filter": "edge",        "params": {"method": "canny", "low_threshold": 25, "high_threshold": 90, "blend_strength": 0.95}},
        {"filter": "contrast",    "params": {"alpha": 1.4, "beta": 5}},
        {"filter": "morphology",  "params": {"operation": "close", "kernel_size": 2, "kernel_shape": "ellipse"}},
        {"filter": "sharpen",     "params": {"strength": 1.0, "kernel_size": 5, "sigma": 1.0}},
        {"filter": "texture",     "params": {"mode": "paper", "strength": 0.08, "seed": 42}},
        {"filter": "blend",       "params": {"mode": "overlay", "strength": 0.25}}
    ]
}
