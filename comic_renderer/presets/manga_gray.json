{
    "name": "manga_gray",
    "description": "Clean grayscale manga style with crisp ink outlines and screentone-ready contrast. Suitable for shōnen and shōjo manga.",
    "version": "2.0",
    "pipeline": [
        {"filter": "grayscale",   "params": {"method": "luminance"}},
        {"filter": "clahe",       "params": {"clip_limit": 3.0, "tile_grid_size": [8, 8]}},
        {"filter": "edge",        "params": {"method": "canny", "low_threshold": 30, "high_threshold": 100, "blend_strength": 0.90}},
        {"filter": "contrast",    "params": {"alpha": 1.4, "beta": 0}},
        {"filter": "morphology",  "params": {"operation": "close", "kernel_size": 2, "kernel_shape": "ellipse"}},
        {"filter": "sharpen",     "params": {"strength": 1.5, "kernel_size": 3, "sigma": 0.8}},
        {"filter": "blend",       "params": {"mode": "soft_light", "strength": 0.2}}
    ]
}
