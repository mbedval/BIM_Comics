{
    "name": "posterized",
    "description": "Bold, flat-colour pop-art style with a reduced colour palette. Inspired by Andy Warhol screen-printing and classic Silver Age comics.",
    "version": "2.0",
    "pipeline": [
        {"filter": "clahe",      "params": {"clip_limit": 4.5, "tile_grid_size": [16, 16]}},
        {"filter": "tonecurve",  "params": {"points": [[0, 0], [20, 80], [45, 105], [90, 120], [150, 160], [255, 255]]}},
        {"filter": "posterize",  "params": {"levels": 5}},
        {"filter": "edge",       "params": {"method": "canny", "low_threshold": 40, "high_threshold": 120, "blend_strength": 0.8, "blur_radius": 1}},
        {"filter": "contrast",   "params": {"alpha": 1.2, "beta": 0}},
        {"filter": "sharpen",    "params": {"strength": 0.5, "kernel_size": 3, "sigma": 0.5}},
        {"filter": "texture",    "params": {"mode": "paper", "strength": 0.05, "seed": 42}},
        {"filter": "blend",      "params": {"mode": "overlay", "strength": 0.2}}
    ]
}
