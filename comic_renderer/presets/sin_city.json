{
    "name": "sin_city",
    "description": "Softened neo-noir comic style with controlled medium contrast, fine stipple shading, thin etched linework, and realistic facial details.",
    "version": "2.0",
    "pipeline": [
        {"filter": "grayscale",   "params": {"method": "luminance"}},
        {"filter": "bilateral",   "params": {"diameter": 5, "sigma_color": 25.0, "sigma_space": 25.0}},
        {"filter": "clahe",       "params": {"clip_limit": 2.0, "tile_grid_size": [8, 8]}},
        {"filter": "tonecurve",   "params": {"points": [[0, 0], [64, 55], [128, 128], [192, 200], [255, 255]]}},
        {"filter": "edge",        "params": {"method": "canny", "low_threshold": 40, "high_threshold": 110, "blend_strength": 0.5, "blur_radius": 1}},
        {"filter": "halftone",    "params": {"size": 2, "angle": 45.0, "blend_strength": 0.12}},
        {"filter": "texture",     "params": {"mode": "grain", "strength": 0.06, "seed": 42, "grain_size": 1}},
        {"filter": "contrast",    "params": {"alpha": 1.05, "beta": -5}}
    ]
}
